{
	"name": "my-doryoku-log",
	"private": true,
	"version": "0.0.1",
	"author": "KiyonoKara",
	"type": "module",
	"main": "electron.js",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest",
		"rebuild:electron": "electron-rebuild -f -w better-sqlite3",
		"electron:dev": "pnpm run build && pnpm run rebuild:electron && electron .",
		"pack": "pnpm run build && electron-builder build",
		"pack:mac:x64": "pnpm run build && pnpm run rebuild:electron && electron-builder build --mac zip --x64 --publish never",
		"pack:mac:arm64": "pnpm run build && pnpm run rebuild:electron && electron-builder build --mac zip --arm64 --publish never",
		"pack:win:x64": "pnpm run build && pnpm run rebuild:electron && electron-builder build --win nsis --x64 --publish never",
		"pack:linux:x64": "pnpm run build && pnpm run rebuild:electron && electron-builder build --linux AppImage --x64 --publish never"
	},
	"build": {
		"appId": "org.kiyo.my-doryoku-log",
		"productName": "My Doryoku Log",
		"directories": {
			"output": "dist-electron"
		},
		"files": [
			"electron.js",
			"preload.cjs",
			"db-init.js",
			"icons/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "build",
				"to": "server",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "drizzle",
				"to": "drizzle",
				"filter": [
					"**/*"
				]
			}
		],
		"asar": true,
		"asarUnpack": [
			"**/*.node",
			"node_modules/better-sqlite3/**/*"
		],
		"npmRebuild": true,
		"nativeRebuilder": "sequential",
		"buildDependenciesFromSource": false,
		"nodeGypRebuild": false,
		"mac": {
			"category": "public.app-category.productivity",
			"icon": "icons/MDL-Icon-Mac-Default@1x.icns",
			"identity": null,
			"target": [
				{
					"target": "zip",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"win": {
			"icon": "icons/MDL-Icon-Default.png",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"linux": {
			"icon": "icons/MDL-Icon-Default.png",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	},
	"devDependencies": {
		"@electron/rebuild": "^4.0.4",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.2",
		"electron": "^41.5.0",
		"electron-builder": "^26.8.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.53.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.3.2",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"better-sqlite3": "^12.5.0"
	}
}
